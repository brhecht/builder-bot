# --- Weekly "Builder of the Week" (Friday 3 PM ET via /api/weekly cron) ---
# Requires extra Slack scopes: reactions:read + pins:write (reinstall the app).
# User IDs excluded from winning (Brian + the bot's own user ID), comma-sep.
SLACK_BOW_EXCLUDE_IDS=U0AQPP9T4QZ
# TRIAL MODE: when set, the weekly announcement goes to these DM targets and the
# auto-pin is skipped. Clear this var to go live (post to #general + pin).
# Trial value = Nico + Brian DMs.
SLACK_BOW_TARGETS=U0AQEF27PMJ,U0AQPP9T4QZ
