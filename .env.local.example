# Slack (Brian will DM these values)
SLACK_BOT_TOKEN=xoxb-...

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Slack channel IDs (get from Brian or via Slack admin)
SLACK_CHANNEL_INTRODUCE_YOURSELF=C...
SLACK_CHANNEL_SHARE_AND_DISCUSS=C...
SLACK_CHANNEL_WHAT_IM_BUILDING=C...
SLACK_CHANNEL_GENERAL=C...
SLACK_DAILY_RECAP_CHANNEL_ID=C0AUS1Q7917

# Upstash Redis (auto-injected by Vercel after running: vercel integration add upstash)
UPSTASH_REDIS_REST_URL=https://...
UPSTASH_REDIS_REST_TOKEN=...

# Vercel cron auth (set in Vercel dashboard, auto-injected on cron calls)
CRON_SECRET=...

# --- Weekly "Builder of the Week" (Friday 3 PM ET via /api/weekly cron) ---
# Requires extra Slack scopes: reactions:read + pins:write (reinstall the app).
# User IDs excluded from winning (Brian + the bot's own user ID), comma-sep.
SLACK_BOW_EXCLUDE_IDS=U0AQPP9T4QZ
# TRIAL MODE: when set, the weekly announcement goes to these DM targets and the
# auto-pin is skipped. Clear this var to go live (post to #general + pin).
# Trial value = Nico + Brian DMs.
SLACK_BOW_TARGETS=U0AQEF27PMJ,U0AQPP9T4QZ

# --- Referrer intro DM (TNB-633, /api/slack/events) ---
# Flag. Unset = off (default). "dry_run" = lookups + log only. "true" = live.
REFERRER_DM_ENABLED=
# Builder Bot Slack app > Basic Information > Signing Secret (TNB workspace app, not the HC intake app)
TNB_SLACK_SIGNING_SECRET=
# Linear personal API key. Reads TNB CRM cards, comments on them. Never used outside the CRM team.
LINEAR_API_KEY=
# Optional. Linear team key of TNB CRM (default CRM).
LINEAR_CRM_TEAM_KEY=
# Optional. Comma-separated Slack user IDs that never get the referrer DM (Brian).
REFERRER_DM_SKIP_IDS=

# --- Join mark (TNB-674, /api/slack/events) ---
# Flag. Unset = off (default). "dry_run" = lookups + log only. "true" = live:
# TNB SLACK label + move to 4. Accepted on the joiner's CRM card. Uses the same
# TNB_SLACK_SIGNING_SECRET and LINEAR_API_KEY as the referrer DM.
JOIN_MARK_ENABLED=
# Optional. Label and status names in TNB CRM (defaults: TNB SLACK, 4. Accepted).
JOIN_MARK_LABEL=
JOIN_MARK_STATE=
